@model AuthViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = Model.Mode == "register" ? "Criar conta" : "Entrar";
    var registering = Model.Mode == "register";
}
<main class="auth-page">
    <header class="auth-brand">
        <img class="aster-logo" src="~/images/auth/VERSÃO 6 LOGO DA ÁSTER.svg" alt="Áster Link" />
    </header>
    <section class="auth-intro" aria-labelledby="portal-title">
        <div class="wifi-halo" aria-hidden="true">
            <span class="wifi-badge">
                <img src="~/images/auth/portal/wifi-hero.svg" alt="" />
            </span>
        </div>
        <h1 id="portal-title">Conecte-se ao<br />Wi-Fi Ásterlink</h1>
        <p>Acesse o portal para realizar o pagamento e garantir sua conexão com a internet.</p>
    </section>
    <section class="auth-card" aria-labelledby="auth-title">
        <h1 id="auth-title" class="visually-hidden">@(registering ? "Criar conta" : "Entrar")</h1>
        <nav class="auth-tabs" aria-label="Autenticação">
            <a class="auth-tab @(!registering ? "active" : null)" asp-action="Index" asp-route-mode="login">Entrar
            </a>
            <a class="auth-tab @(registering ? "active" : null)" asp-action="Index" asp-route-mode="register">
                Criar Conta</a>
        </nav>

        @if (!registering)
        {
            <form asp-action="Login" method="post" class="auth-form" novalidate>
                <div asp-validation-summary="ModelOnly" class="form-alert"></div>
                <div class="field-group">
                    <label asp-for="Login.Identifier">Login ou e-mail</label>
                    <div class="input-shell">
                        <img src="~/images/auth/email.svg" alt="" />
                        <input asp-for="Login.Identifier" autocomplete="username"
                            placeholder="seu login" />
                    </div>
                    <span asp-validation-for="Login.Identifier" class="field-error"></span>
                </div>
                <div class="field-group password-group">
                    <div class="label-row">
                        <label asp-for="Login.Password">Senha</label>
                        <span class="forgot-link" title="Recuperação de senha em breve">Esqueci
                            minha senha</span>
                    </div>
                    <div class="input-shell">
                        <img src="~/images/auth/password.svg" alt="" />
                        <input asp-for="Login.Password" type="password"
                            autocomplete="current-password" placeholder="••••••••" data-password />
                        <button type="button" class="password-toggle" data-password-toggle
                            aria-label="Mostrar senha">
                            <img src="~/images/auth/eye.svg" alt="" />
                        </button>
                    </div>
                    <span asp-validation-for="Login.Password" class="field-error"></span>
                </div>
                <button class="submit-button" type="submit">
                    <span>ACESSAR REDE</span>
                    <img src="~/images/auth/arrow.svg" alt="" />
                </button>
            </form>
        }
        else
        {
            <form asp-action="Register" method="post" class="auth-form register-form" novalidate>
                <div asp-validation-summary="ModelOnly" class="form-alert"></div>
                <div class="field-group">
                    <label asp-for="Register.Name">Nome</label>
                    <div class="input-shell">
                        <span class="text-icon">Aa</span>
                        <input asp-for="Register.Name" autocomplete="name" placeholder="Seu nome" />
                    </div>
                    <span asp-validation-for="Register.Name" class="field-error"></span>
                </div>
                <div class="field-group">
                    <label asp-for="Register.Username">Login</label>
                    <div class="input-shell">
                        <span class="text-icon">@@</span>
                        <input asp-for="Register.Username" autocomplete="username"
                            placeholder="seu.login" />
                    </div>
                    <span asp-validation-for="Register.Username" class="field-error"></span>
                </div>
                <div class="field-group">
                    <label asp-for="Register.Email">E-mail</label>
                    <div class="input-shell">
                        <img src="~/images/auth/email.svg" alt="" />
                        <input asp-for="Register.Email" autocomplete="email"
                            placeholder="usuario@aster.com" />
                    </div>
                    <span asp-validation-for="Register.Email" class="field-error"></span>
                </div>
                <div class="field-group">
                    <label asp-for="Register.Cpf">CPF</label>
                    <div class="input-shell">
                        <span class="text-icon">ID</span>
                        <input asp-for="Register.Cpf" type="text" inputmode="numeric" autocomplete="off"
                            maxlength="14" placeholder="000.000.000-00" />
                    </div>
                    <span asp-validation-for="Register.Cpf" class="field-error"></span>
                </div>
                <div class="field-grid">
                    <div class="field-group">
                        <label asp-for="Register.Password">Senha</label>
                        <div class="input-shell">
                            <img src="~/images/auth/password.svg" alt="" />
                            <input asp-for="Register.Password" type="password"
                                autocomplete="new-password" placeholder="8+ caracteres" />
                        </div>
                        <span asp-validation-for="Register.Password" class="field-error"></span>
                    </div>
                    <div class="field-group">
                        <label asp-for="Register.ConfirmPassword">Confirmar</label>
                        <div class="input-shell">
                            <img src="~/images/auth/password.svg" alt="" />
                            <input asp-for="Register.ConfirmPassword" type="password"
                                autocomplete="new-password" placeholder="Repita a senha" />
                        </div>
                        <span asp-validation-for="Register.ConfirmPassword" class="field-error">
                        </span>
                    </div>
                </div>
                <button class="submit-button" type="submit">
                    <span>Cadastrar</span>
                    <img src="~/images/auth/arrow.svg" alt="" />
                </button>
            </form>
        }

    </section>
    <section class="auth-benefits" aria-label="Qualidades da conexão">
        <div class="auth-benefit">
            <img src="~/images/auth/portal/fast.svg" alt="" />
            <span>Rápido</span>
        </div>
        <div class="auth-benefit">
            <img src="~/images/auth/portal/secure.svg" alt="" />
            <span>Seguro</span>
        </div>
        <div class="auth-benefit">
            <img src="~/images/auth/portal/stable.svg" alt="" />
            <span>Estável</span>
        </div>
    </section>
    <footer class="auth-footer">
        <div class="auth-wave" aria-hidden="true"></div>
        <span>Ásterlink | Internet que te conecta</span>
    </footer>
</main>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
