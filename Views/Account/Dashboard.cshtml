@using System.Globalization
@model PlansViewModel
@{
    Layout = "_PlansLayout";
    ViewData["Title"] = "Escolha seu plano";
    var culture = CultureInfo.GetCultureInfo("pt-BR");
    var selectedPlan = Model.Plans.FirstOrDefault(plan => plan.IsPopular)
        ?? Model.Plans.FirstOrDefault();

    string DurationLabel(int minutes)
    {
        if (minutes < 60)
        {
            return $"{minutes} minutos";
        }

        var hours = minutes / 60;

        return hours == 1 ? "1 hora" : $"{hours} horas";
    }
}
<div class="plans-page">
    <header class="top-bar">
        <button class="icon-button" type="button" aria-label="Abrir menu">
            <img src="~/images/plans/menu.svg" alt="" />
        </button>
        <img class="top-logo" src="~/images/auth/VERSÃO 6 LOGO DA ÁSTER.svg" alt="Áster Link" />
        <div class="account-menu">
            <button class="user-avatar account-menu-trigger" type="button"
                aria-label="Abrir menu da conta" aria-expanded="false"
                aria-controls="account-menu-panel">
                <img src="~/images/plans/user.svg" alt="" />
            </button>
            <div class="account-menu-panel" id="account-menu-panel" hidden>
                <span class="account-menu-name">@User.Identity?.Name</span>
                <form asp-action="Logout" method="post">
                    <button class="logout-button" type="submit">Sair</button>
                </form>
            </div>
        </div>
    </header>

    <main class="plans-content" id="plans">
        <section class="plans-heading">
            <h1>Escolha seu plano</h1>
            <p>Navegue com liberdade. Conecte-se do seu jeito.</p>
        </section>

        <section class="plans-panel">
            @if (Model.Plans.Count == 0)
            {
                <p class="plans-empty">Nenhum plano disponível no momento.</p>
            }
            else
            {
                <div class="plans-list" role="radiogroup" aria-label="Planos disponíveis">
                    @for (var index = 0; index < Model.Plans.Count; index++)
                    {
                        var plan = Model.Plans[index];
                        var theme = index switch
                        {
                            0 => "basic",
                            1 => "essential",
                            2 => "plus",
                            _ => "premium"
                        };
                        var icon = plan.IsPopular ? "crown.svg" : "clock.svg";
                        var checkoutUrl = Url.Action("Index", "Checkout", new { planId = plan.Id });

                        <div class="plan-option plan-theme-@theme">
                            <input class="plan-radio" type="radio" name="selectedPlan"
                                id="plan-@plan.Id" value="@plan.Id"
                                data-checkout-url="@checkoutUrl"
                                checked="@(plan.Id == selectedPlan!.Id ? "checked" : null)" />
                            <label class="plan-card" for="plan-@plan.Id">
                                <span class="plan-summary">
                                    <span class="plan-icon" aria-hidden="true">
                                        <img src="~/images/plans/figma/@icon" alt="" />
                                    </span>
                                    <span class="plan-copy">
                                        <strong>@plan.Name</strong>
                                        <span>@plan.SpeedMbps Mbps</span>
                                    </span>
                                </span>
                                <span class="plan-purchase">
                                    <span class="plan-values">
                                        <span>@DurationLabel(plan.DurationMinutes)</span>
                                        <strong>R$ @plan.Price.ToString("N2", culture)</strong>
                                    </span>
                                    <span class="choice-indicator" aria-hidden="true"></span>
                                </span>

                                @if (plan.IsPopular)
                                {
                                    <span class="popular-badge">Mais escolhido</span>
                                }
                            </label>
                        </div>
                    }
                </div>

                <div class="plan-benefits" aria-label="Benefícios da conexão">
                    <span>
                        <img src="~/images/plans/figma/shield.svg" alt="" />
                        Conexão estável
                    </span>
                    <span>
                        <img src="~/images/plans/figma/speed.svg" alt="" />
                        Alta velocidade
                    </span>
                    <span>
                        <img src="~/images/plans/figma/support.svg" alt="" />
                        Suporte sempre
                    </span>
                </div>

                <a class="continue-plan" href="@Url.Action("Index", "Checkout", new { planId = selectedPlan!.Id })"
                    data-continue-plan>
                    <span>Continuar com o plano selecionado</span>
                    <img src="~/images/plans/figma/arrow.svg" alt="" />
                </a>
            }
        </section>
    </main>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const accountTrigger = document.querySelector('.account-menu-trigger');
        const accountPanel = document.getElementById('account-menu-panel');
        const continueButton = document.querySelector('[data-continue-plan]');
        const planRadios = document.querySelectorAll('.plan-radio');

        if (accountTrigger && accountPanel) {
            accountTrigger.addEventListener('click', () => {
                const open = accountPanel.hidden;
                accountPanel.hidden = !open;
                accountTrigger.setAttribute('aria-expanded', String(open));
            });

            document.addEventListener('click', event => {
                if (event.target instanceof Element && !event.target.closest('.account-menu')) {
                    accountPanel.hidden = true;
                    accountTrigger.setAttribute('aria-expanded', 'false');
                }
            });
        }

        for (const radio of planRadios) {
            radio.addEventListener('change', () => {
                if (radio.checked && continueButton && radio.dataset.checkoutUrl) {
                    continueButton.href = radio.dataset.checkoutUrl;
                }
            });
        }
    });
</script>
