@using System.Globalization
@model PlansViewModel
@{
    Layout = "_PlansLayout";
    ViewData["Title"] = "Escolha seu plano";
    var culture = CultureInfo.GetCultureInfo("pt-BR");
}
<div class="plans-page">
    <header class="top-bar">
        <button class="icon-button" type="button" aria-label="Abrir menu">
            <img src="~/images/plans/menu.svg" alt="" />
        </button>
        <img class="top-logo" src="~/images/auth/VERSÃO 6 LOGO DA ÁSTER.svg" alt="Áster Link" />
        <div class="account-menu">
            <button class="user-avatar account-menu-trigger" type="button"
                aria-label="Abrir menu da conta" aria-expanded="false"
                aria-controls="account-menu-panel">
                <img src="~/images/plans/user.svg" alt="" />
            </button>
            <div class="account-menu-panel" id="account-menu-panel" hidden>
                <span class="account-menu-name">@User.Identity?.Name</span>
                <form asp-action="Logout" method="post">
                    <button class="logout-button" type="submit">Sair</button>
                </form>
            </div>
        </div>
    </header>
    <main class="plans-content" id="plans">
        <section class="plans-heading">
            <h1>Escolha seu<br />Plano</h1>
            <p>Selecione o tempo de conexão ideal para sua necessidade. Alta velocidade e
                estabilidade garantidas.</p>
        </section>
        <a class="sponsor-card" href="https://asterlink.com.br" target="_blank"
            rel="noopener noreferrer">
            <span class="sponsor-image">
                <img src="~/images/auth/sponsor.png" alt="" />
            </span>
            <span class="sponsor-copy"><small>Banner de Patrocínio</small><strong>Ultra Fibra
                    Áster</strong>
                <span>Conectividade sem limites…</span>
            </span>
            <span class="sponsor-arrow">
                <img src="~/images/auth/external-link.svg" alt="" />
            </span>
        </a>

        @if (Model.Plans.Count == 0)
        {
            <p class="plans-empty">Nenhum plano disponível no momento.</p>
        }
        else
        {
            <section class="plans-grid" aria-label="Planos disponíveis">

                @for (var index = 0; index < Model.Plans.Count; index++)
                {
                    var plan = Model.Plans[index];
                    var icon = plan.IsPopular ? "popular.svg" : index % 2 == 0 ? "clock.svg" : "hourglass.svg";

                    <article class="plan-card @(plan.IsPopular ? "popular" : null)">

                        @if (plan.IsPopular)
                        {
                            <span class="popular-badge">Mais Popular</span>
                        }

                        <span class="plan-icon">
                            <img src="~/images/plans/@icon" alt="" />
                        </span>
                        <h2>@plan.Name</h2>
                        <p class="plan-price"><small>R$</small><strong>@plan.Price.ToString("N2",
                                culture)</strong></p>
                        <a class="select-plan"
                            style="display:block;text-align:center;text-decoration:none"
                            asp-controller="Checkout" asp-action="Index"
                            asp-route-planId="@plan.Id">Selecionar</a>
                    </article>
                }

            </section>
        }

    </main>
    <nav class="bottom-nav" aria-label="Navegação principal">
        <a href="#">
            <img src="~/images/plans/home.svg" alt="" />
            <span>Home</span>
        </a>
        <a class="active" href="#plans">
            <img src="~/images/plans/plans.svg" alt="" />
            <span>Plans</span>
        </a>
        <a href="#">
            <img src="~/images/plans/activity.svg" alt="" />
            <span>Activity</span>
        </a>
        <form asp-action="Logout" method="post">
            <button type="submit">
                <img src="~/images/plans/account.svg" alt="" />
                <span>Account</span>
            </button>
        </form>
    </nav>
</div>

<style>
    .account-menu {
        position: relative;
    }
    .account-menu-trigger {
        cursor: pointer;
    }
    .account-menu-panel {
        position: absolute;
        z-index: 20;
        top: 44px;
        right: 0;
        width: 172px;
        padding: 12px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 10px;
        background: #141a2d;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);
    }
    .account-menu-panel[hidden] {
        display: none;
    }
    .account-menu-name {
        display: block;
        overflow: hidden;
        margin: 0 0 10px;
        color: #dde1fa;
        font:
            500 12px/16px 'JetBrains Mono',
            monospace;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .account-menu-panel form {
        margin: 0;
    }
    .logout-button {
        width: 100%;
        padding: 9px 12px;
        border: 1px solid rgba(255, 105, 125, 0.45);
        border-radius: 7px;
        background: rgba(255, 80, 100, 0.1);
        color: #ffabb5;
        cursor: pointer;
        font:
            500 12px/16px 'JetBrains Mono',
            monospace;
    }
    .logout-button:hover {
        background: rgba(255, 80, 100, 0.2);
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const trigger = document.querySelector('.account-menu-trigger'),
            panel = document.getElementById('account-menu-panel');
        if (!trigger || !panel) return;
        trigger.addEventListener('click', () => {
            const open = panel.hidden;
            panel.hidden = !open;
            trigger.setAttribute('aria-expanded', String(open));
        });
        document.addEventListener('click', (event) => {
            if (!event.target.closest('.account-menu')) {
                panel.hidden = true;
                trigger.setAttribute('aria-expanded', 'false');
            }
        });
    });
</script>
