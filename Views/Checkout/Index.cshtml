@using System.Globalization
@using System.Text.Json
@model CheckoutViewModel
@{
    Layout = "_PlansLayout";
    ViewData["Title"] = "Checkout";
    var culture = CultureInfo.GetCultureInfo("pt-BR");
}
<main class="checkout-page">
    <a class="checkout-back" asp-controller="Account" asp-action="Dashboard">← Voltar aos planos</a>
    <section class="checkout-summary">
        <span>Plano selecionado</span>
        <h1>@Model.Plan.Name</h1>
        <p>R$ <strong>@Model.Plan.Price.ToString("N2", culture)</strong></p>
    </section>
    <section class="checkout-card">
        <h2>Escolha como pagar</h2>
        <p>PIX, cartão de crédito ou débito.</p>
        @Html.AntiForgeryToken()
        <div id="paymentBrick_container">
        </div>
        <div id="checkout-message" class="checkout-message" hidden></div>
        <section id="pix-payment" class="pix-payment" hidden aria-live="polite">
            <h3>Pague com PIX</h3>
            <p>Escaneie o QR Code no aplicativo do seu banco ou copie o código abaixo.</p>
            <img id="pix-qr-code" class="pix-qr-code" alt="QR Code para pagamento PIX" />
            <label for="pix-copy-code">PIX copia e cola</label>
            <textarea id="pix-copy-code" readonly aria-label="Código PIX copia e cola"></textarea>
            <button id="copy-pix-code" class="copy-pix-button" type="button">Copiar código PIX
            </button>
            <a id="pix-ticket-link" class="pix-ticket-link" target="_blank"
                rel="noopener noreferrer" hidden>Ver instruções do pagamento</a>
        </section>
    </section>
</main>

<script src="https://sdk.mercadopago.com/js/v2"></script>

<script>
    window.asterCheckout = @Html.Raw(JsonSerializer.Serialize(new
    {
        publicKey = Model.PublicKey,
        planId = Model.Plan.Id,
        amount = Model.Plan.Price,
        payerEmail = Model.PayerEmail
    }));
</script>

<script src="~/js/checkout.js" asp-append-version="true"></script>
